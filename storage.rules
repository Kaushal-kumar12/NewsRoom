rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validImageOrVideo() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|application/pdf');
    }

    match /media/news/{newsId}/{folder}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && validImageOrVideo();
    }

    match /media/users/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && validImageOrVideo();
    }

    match /media/advertisements/{fileName} {
      allow read: if true;
      allow write: if signedIn() && validImageOrVideo();
    }
  }
}
